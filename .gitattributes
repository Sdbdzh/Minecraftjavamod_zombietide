# Normalize text files to LF inside the repository
* text=auto

# Gradle wrapper shell script must keep LF (otherwise Git Bash fails with \r)
gradlew text eol=lf
*.bat text eol=crlf

# Source / config / docs
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary assets
*.jar binary
*.png binary
